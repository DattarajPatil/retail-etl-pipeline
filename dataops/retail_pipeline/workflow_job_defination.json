{
  "name": "retail-etl-pipeline",
  "max_concurrent_runs": 1,
  "git_source": {
    "git_url": "https://github.com/DattarajPatil/retail-etl-pipeline",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "environments": [
    {
      "environment_key": "default",
      "spec": {
        "environment_version": "2"
      }
    }
  ],
  "tasks": [
    {
      "task_key": "raw_ingest",
      "description": "Source files in retail.raw.landing -> retail.raw.* (append, string columns, lineage metadata)",
      "environment_key": "default",
      "spark_python_task": {
        "python_file": "dataops/retail_pipeline/run_pipeline.py",
        "parameters": [
          "--layer",
          "raw"
        ],
        "source": "GIT"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "timeout_seconds": 3600
    },
    {
      "task_key": "refine_transform",
      "description": "retail.raw.* -> retail.refined.* (types, cleaning, dedupe, rejected rows)",
      "depends_on": [
        {
          "task_key": "raw_ingest"
        }
      ],
      "environment_key": "default",
      "spark_python_task": {
        "python_file": "dataops/retail_pipeline/run_pipeline.py",
        "parameters": [
          "--layer",
          "refined"
        ],
        "source": "GIT"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "timeout_seconds": 3600
    },
    {
      "task_key": "confirm_curated",
      "description": "retail.refined.* -> retail.curated.* (dims, fact_sales, aggregates)",
      "depends_on": [
        {
          "task_key": "refine_transform"
        }
      ],
      "environment_key": "default",
      "spark_python_task": {
        "python_file": "dataops/retail_pipeline/run_pipeline.py",
        "parameters": [
          "--layer",
          "curated"
        ],
        "source": "GIT"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "timeout_seconds": 3600
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "PAUSED"
  },
  "tags": {
    "project": "retail-etl-pipeline",
    "layers": "raw-refined-curated"
  }
}